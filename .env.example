# ====================================================================
# ANUP FABRICATION - ENVIRONMENT VARIABLES CONFIGURATION
# Intended Deployment URL: https://anupfabrication.infinityfree.me
# ====================================================================

# --------------------------------------------------------------------
# 1. PUBLIC FRONTEND VARIABLES (Accessible in React via import.meta.env)
# --------------------------------------------------------------------
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# Supabase publishable anonymous key
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Razorpay Test / Live Key ID (Public key for checkout modal)
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# --------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (Never commit to Git or expose to browser)
# --------------------------------------------------------------------
# Gemini API Key: Injected automatically by AI Studio or set in Supabase Secrets
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Razorpay Key Secret (Used in server / Edge function for HMAC validation)
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# Razorpay Webhook Secret
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# Supabase Service Role Key (Only used in privileged administrative backend scripts)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
